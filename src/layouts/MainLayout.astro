---
import type { ImageMetadata } from 'astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHead from '../components/layout/SiteHead.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { siteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
}

const { title, description, image, imageAlt, type = 'website', noindex = false, publishedTime, modifiedTime } = Astro.props;

const directionContract = `<!--
  Arkedia direction contract (seed: a7c31e09)
  THESIS: Arkedia is a shelf of game boxes; each game page is an opened box, board and rule sheet side by side. Refuses the SaaS hero and the identical card grid.
  OWN-WORLD: chipboard paper ground (#f2eee5), black ink (#1d1c1a), one process ink per game used as solid fills. Archivo expanded black for lids and titles, Source Serif 4 for rule-sheet prose. Die-cut 6px corners, 2px ink rules, boards drawn as crisp printed geometry.
  FIRST VIEWPORT: a short headline ("Learn it in a minute. Then play it.") with the shelf of all 14 box lids in their inks.
  SIGNATURE: numbered quick rules beside a live board, and progress stamps (Played / Won / Best) printed onto lids from localStorage.
  RISK: 14 inks turning into confetti. Ink fills only on lids, title bands, pieces and active or win states; everything else is paper and black.
-->`;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <SiteHead
      title={title}
      description={description}
      site={Astro.site}
      pathname={Astro.url.pathname}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip antialiased"><Fragment set:html={directionContract} />
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-die focus:border-2 focus:border-ink focus:bg-card focus:px-4 focus:py-2 focus:font-semibold focus:text-ink"
      href="#content"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="content" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
