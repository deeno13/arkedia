---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'section' | 'header' | 'nav';
  size?: 'narrow' | 'default';
}

const { as: Tag = 'div', size = 'default', class: className = '', ...rest } = Astro.props;

const sizeClasses = {
  narrow: 'max-w-3xl',
  default: 'max-w-[78rem]',
};
---

<Tag class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', sizeClasses[size], className]} {...rest}>
  <slot />
</Tag>
