---
interface Props {
  title: string;
  tone?: 'info' | 'neutral';
  headingTag?: 'h2' | 'h3' | 'p';
  class?: string;
}

const { title, tone = 'info', headingTag: HeadingTag = 'h3', class: className = '' } = Astro.props;

const toneClasses = {
  info: 'border-sky-200 bg-sky-50/80',
  neutral: 'border-slate-200 bg-slate-50/80',
};
---

<aside class:list={['rounded-3xl border p-6 shadow-sm shadow-slate-200/40', toneClasses[tone], className]}>
  <HeadingTag class="text-base font-semibold text-slate-950">{title}</HeadingTag>
  <div class="mt-3 text-sm leading-7 text-slate-700">
    <slot />
  </div>
</aside>
