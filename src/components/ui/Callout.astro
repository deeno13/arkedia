---
/* A rule card for MDX guides: a challenge or aside printed on its own slip of card. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="my-8 rounded-die border-2 border-ink bg-paper-deep px-5 py-4 sm:px-6 sm:py-5">
  <p class="font-sans text-base leading-snug font-extrabold font-stretch-expanded">{title}</p>
  <div class="mt-2 text-[1.0625rem] leading-relaxed [&>:first-child]:mt-0 [&>:last-child]:mb-0 [&_p]:my-2">
    <slot />
  </div>
</aside>
