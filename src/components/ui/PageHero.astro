---
import Container from '../layout/Container.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  size?: 'narrow' | 'default' | 'wide';
  class?: string;
}

const { eyebrow, title, description, size = 'default', class: className = '' } = Astro.props;
const hasMedia = Astro.slots.has('media');
const hasActions = Astro.slots.has('actions');
const hasBreadcrumbs = Astro.slots.has('breadcrumbs');
const hasMeta = Astro.slots.has('meta');
---

<section class:list={['pt-6 sm:pt-10', className]}>
  <Container size={size}>
    <div class:list={['grid gap-8', hasMedia && 'items-center lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)]']}>
      <div class="max-w-3xl">
        {hasBreadcrumbs && <div class="mb-5"><slot name="breadcrumbs" /></div>}
        {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.28em] text-sky-700">{eyebrow}</p>}
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">{title}</h1>
        {description && <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700">{description}</p>}
        {hasMeta && <div class="mt-6"><slot name="meta" /></div>}
        {hasActions && <div class="mt-8 flex flex-wrap gap-3"><slot name="actions" /></div>}
      </div>

      {hasMedia && <div class="lg:justify-self-end"><slot name="media" /></div>}
    </div>
  </Container>
</section>
