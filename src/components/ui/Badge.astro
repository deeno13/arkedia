---
interface Props {
  tone?: 'accent' | 'neutral' | 'warm';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props;

const toneClasses = {
  accent: 'border-sky-200 bg-sky-50 text-sky-800',
  neutral: 'border-slate-200 bg-slate-50 text-slate-700',
  warm: 'border-amber-200 bg-amber-50 text-amber-800',
};
---

<span class:list={['inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium', toneClasses[tone], className]}>
  <slot />
</span>
