---
/* Arkedia's mark: three game boxes standing on a shelf, the middle one opened. */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 28" aria-hidden="true" focusable="false">
  <rect x="1.5" y="7" width="8" height="17" rx="1.5" fill="currentColor" />
  <rect x="12.25" y="2.25" width="7.5" height="21.75" rx="1.5" fill="none" stroke="currentColor" stroke-width="2.5" />
  <rect x="22.5" y="11" width="8" height="13" rx="1.5" fill="currentColor" />
  <rect x="0" y="25" width="32" height="3" fill="currentColor" />
</svg>
