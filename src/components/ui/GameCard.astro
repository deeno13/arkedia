---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'games'>;
}

const { entry } = Astro.props;
---

<article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 transition hover:-translate-y-0.5 hover:shadow-md">
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-700">{entry.data.difficulty}</p>
    {entry.data.widget && (
      <span class="rounded-full bg-sky-100 px-3 py-1 text-xs font-medium text-sky-800">Interactive widget</span>
    )}
  </div>

  <h2 class="mt-4 text-xl font-semibold tracking-tight text-slate-950">
    <a class="hover:text-sky-800" href={`/games/${entry.id}/`}>{entry.data.title}</a>
  </h2>

  <p class="mt-3 text-sm leading-6 text-slate-700">{entry.data.excerpt}</p>

  {entry.data.tags.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2 text-xs text-slate-600">
      {entry.data.tags.map((tag) => (
        <li class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">{tag}</li>
      ))}
    </ul>
  )}
</article>
