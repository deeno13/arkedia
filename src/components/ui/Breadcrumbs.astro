---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-600">
    {items.map((item, index) => (
      <>
        <li>
          {item.href ? (
            <a class="transition hover:text-slate-950" href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page" class="text-slate-950">{item.label}</span>
          )}
        </li>
        {index < items.length - 1 && <li aria-hidden="true" class="text-slate-400">/</li>}
      </>
    ))}
  </ol>
</nav>
