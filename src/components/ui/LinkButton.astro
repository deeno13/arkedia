---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  class?: string;
  external?: boolean;
}

const { href, variant = 'primary', class: className = '', external = false } = Astro.props;

const variantClasses = {
  primary:
    'bg-slate-950 text-white shadow-sm shadow-slate-900/10 hover:bg-slate-800 focus-visible:outline-slate-950',
  secondary:
    'border border-slate-300 bg-white text-slate-800 hover:border-slate-400 hover:bg-slate-50 focus-visible:outline-slate-950',
  text: 'px-0 text-sky-800 hover:text-sky-900 focus-visible:outline-sky-800',
};
---

<a
  href={href}
  rel={external ? 'noreferrer' : undefined}
  target={external ? '_blank' : undefined}
  class:list={[
    'inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2',
    variantClasses[variant],
    className,
  ]}
>
  <slot />
</a>
