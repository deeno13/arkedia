---
import type { CollectionEntry } from 'astro:content';
import {
  formatCategoryLabel,
  formatDate,
  formatDifficultyLabel,
  formatEstimatedMinutes,
  formatPlayerRange,
} from '../../lib/games';

interface Props {
  entry: CollectionEntry<'games'>;
}

const { entry } = Astro.props;

const facts = [
  { label: 'Category', value: formatCategoryLabel(entry.data.category) },
  { label: 'Difficulty', value: formatDifficultyLabel(entry.data.difficulty) },
  { label: 'Players', value: formatPlayerRange(entry.data.minPlayers, entry.data.maxPlayers) },
  { label: 'Typical session', value: formatEstimatedMinutes(entry.data.estimatedMinutes) },
  { label: 'Format', value: entry.data.isPlayable ? 'Guide plus widget' : 'Editorial guide' },
  { label: 'Updated', value: formatDate(entry.data.updatedAt ?? entry.data.publishedAt) },
];
---

<dl class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  {facts.map((fact) => (
    <div class="rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-sm shadow-slate-200/50">
      <dt class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">{fact.label}</dt>
      <dd class="mt-3 text-lg font-semibold tracking-tight text-slate-950">{fact.value}</dd>
    </div>
  ))}
</dl>
