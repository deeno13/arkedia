---
import type { CollectionEntry } from 'astro:content';
import {
  formatCategoryLabel,
  formatEstimatedMinutes,
  formatPlayerRange,
  formatStatusLabel,
} from '../../lib/games';

interface Props {
  entry: CollectionEntry<'games'>;
}

const { entry } = Astro.props;

const facts = [
  { label: 'Category', value: formatCategoryLabel(entry.data.category) },
  { label: 'Players', value: formatPlayerRange(entry.data.minPlayers, entry.data.maxPlayers) },
  { label: 'Typical session', value: formatEstimatedMinutes(entry.data.estimatedMinutes) },
  { label: 'Status', value: formatStatusLabel(entry.data.status) },
];
---

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  {facts.map((fact) => (
    <div class="rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-sm shadow-slate-200/50">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">{fact.label}</p>
      <p class="mt-3 text-lg font-semibold tracking-tight text-slate-950">{fact.value}</p>
    </div>
  ))}
</div>
