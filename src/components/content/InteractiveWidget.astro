---
import ConnectFourGame from '../islands/ConnectFourGame';
import CrosswordGame from '../islands/CrosswordGame';
import Game2048 from '../islands/Game2048';
import LightsOutGame from '../islands/LightsOutGame';
import MastermindGame from '../islands/MastermindGame';
import MemoryGame from '../islands/MemoryGame';
import MinesweeperGame from '../islands/MinesweeperGame';
import NimGame from '../islands/NimGame';
import RockPaperScissorsGame from '../islands/RockPaperScissorsGame';
import SnakeGame from '../islands/SnakeGame';
import SudokuGame from '../islands/SudokuGame';
import TicTacToeGame from '../islands/TicTacToeGame';
import TowerOfHanoiGame from '../islands/TowerOfHanoiGame';
import WordleGame from '../islands/WordleGame';
import type { PlayableWidgetKey } from '../../lib/playable-games';

/*
  Boards render client-only: they start from random or device-stored state
  (localStorage progress and preferences), so server HTML would only mismatch.
  The page around the board, including the rules, stays static.
  Astro needs a static import per hydrated component, hence one line per game.
*/
interface Props {
  widget: PlayableWidgetKey;
  slug: string;
  title: string;
}

const { widget, slug, title } = Astro.props;
---

<div class="game-widget" data-widget={widget}>
  {widget === 'snake' && <SnakeGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></SnakeGame>}
  {widget === 'rock-paper-scissors' && <RockPaperScissorsGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></RockPaperScissorsGame>}
  {widget === 'wordle' && <WordleGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></WordleGame>}
  {widget === 'sudoku' && <SudokuGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></SudokuGame>}
  {widget === 'crossword' && <CrosswordGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></CrosswordGame>}
  {widget === 'tic-tac-toe' && <TicTacToeGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></TicTacToeGame>}
  {widget === 'connect-four' && <ConnectFourGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></ConnectFourGame>}
  {widget === 'minesweeper' && <MinesweeperGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></MinesweeperGame>}
  {widget === '2048' && <Game2048 client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></Game2048>}
  {widget === 'mastermind' && <MastermindGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></MastermindGame>}
  {widget === 'nim' && <NimGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></NimGame>}
  {widget === 'tower-of-hanoi' && <TowerOfHanoiGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></TowerOfHanoiGame>}
  {widget === 'memory' && <MemoryGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></MemoryGame>}
  {widget === 'lights-out' && <LightsOutGame client:only="react" slug={slug}><slot name="fallback" slot="fallback" /></LightsOutGame>}
  <noscript>
    <p class="rounded-die border-2 border-ink bg-card p-4 text-sm">
      The {title} board needs JavaScript. The rules and guide on this page work without it.
    </p>
  </noscript>
</div>
