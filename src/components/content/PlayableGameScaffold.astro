---
interface Props {
  title: string;
  summary: string;
  nextSteps?: string[];
}

const { title, summary, nextSteps = [] } = Astro.props;
---

<div class="rounded-[1.5rem] border border-dashed border-slate-300 bg-slate-50/80 p-5">
  <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(14rem,0.8fr)]">
    <div>
      <h3 class="text-lg font-semibold tracking-tight text-slate-950">{title}</h3>
      <p class="mt-3 text-sm leading-7 text-slate-700">{summary}</p>
    </div>

    <div class="rounded-[1.25rem] border border-slate-200 bg-white p-4">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Future extension path</p>
      <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-700">
        {nextSteps.map((step) => <li>{step}</li>)}
      </ul>
    </div>
  </div>
</div>
