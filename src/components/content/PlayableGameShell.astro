---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  controlHints?: string[];
}

const {
  eyebrow,
  title,
  description,
  controlHints = [],
} = Astro.props;

const titleId = `playable-game-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section
  aria-labelledby={titleId}
  class="my-10 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60"
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.3fr)_minmax(18rem,0.7fr)]">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-700">{eyebrow}</p>
      <h2 id={titleId} class="mt-2 text-2xl font-semibold tracking-tight text-slate-950">{title}</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-700">{description}</p>
      <div class="mt-6">
        <slot />
      </div>
    </div>

    <aside class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-5">
      <h3 class="text-sm font-semibold text-slate-950">Controls and hints</h3>
      <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-700">
        {controlHints.map((hint) => <li>{hint}</li>)}
      </ul>
      <div class="mt-5 text-xs leading-6 text-slate-500">
        <slot name="aside" />
      </div>
    </aside>
  </div>
</section>
