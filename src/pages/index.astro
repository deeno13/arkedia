---
import Container from '../components/layout/Container.astro';
import BoxLid from '../components/ui/BoxLid.astro';
import ShelfTile from '../components/ui/ShelfTile.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { siteConfig } from '../data/site';
import { GAME_CATEGORY_LABELS, formatPlayerRange, gameHref, getPublishedGames, getStarterGames } from '../lib/games';

const games = await getPublishedGames();
const slugs = games.map((game) => game.data.slug);
const starters = getStarterGames(games);
const concepts = [...games].sort((left, right) => left.data.concept.localeCompare(right.data.concept));
const gameIndex = games.map((game) => ({
  slug: game.data.slug,
  title: game.data.title,
  href: gameHref(game),
}));
const sectionHeading = 'text-[clamp(1.625rem,3.4vw,2.25rem)] leading-[1.05] font-black font-stretch-expanded tracking-[-0.02em] text-balance';
---

<MainLayout title={`${siteConfig.name}: ${siteConfig.tagline}`} description={siteConfig.description}>
  <Container class="pt-8 sm:pt-12">
    <div class="grid gap-x-12 gap-y-4 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-end">
      <h1 class="max-w-[16ch] text-[clamp(2.375rem,6vw,4.5rem)] leading-[0.94] font-black font-stretch-expanded tracking-[-0.03em] sm:max-w-none">
        Learn it in a minute.<br class="max-sm:hidden" /> Then play it.
      </h1>
      <p class="max-w-[46ch] text-lg leading-snug text-ink-soft sm:text-xl lg:pb-1 lg:text-lg">
        {games.length} classic games, each with its rules, a worked example, real strategy and the idea underneath, and a
        board to play on right beside them.
      </p>
    </div>

    <h2 class="sr-only">All games</h2>
    <ul class="mt-7 grid grid-cols-2 gap-3 sm:mt-9 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 lg:gap-5">
      {games.map((game) => (
        <li><BoxLid entry={game} /></li>
      ))}
      <li>
        <ShelfTile href="/games/" title="Surprise me" text="Open a random box" data-random-game={JSON.stringify(slugs)} />
      </li>
      <li class="sm:max-lg:hidden">
        <ShelfTile href="/games/" title="Sort the shelf" text="Filter by kind, difficulty or players" />
      </li>
    </ul>
  </Container>

  <section id="continue" aria-labelledby="continue-heading" hidden>
    <Container class="mt-20 sm:mt-24">
      <h2 id="continue-heading" class={sectionHeading}>Continue where you left off</h2>
      <ol data-continue-list class="mt-6 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4"></ol>
    </Container>
  </section>

  <Container as="section" aria-labelledby="concepts-heading" class="mt-20 sm:mt-28">
    <div class="grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <div>
        <h2 id="concepts-heading" class={sectionHeading}>Learn an idea by playing it</h2>
        <p class="mt-4 max-w-[40ch] font-serif text-lg leading-relaxed text-ink-soft">
          Every game here is a small working model of a bigger idea. Pick the idea, and the board that teaches it is one click
          away.
        </p>
        <p class="mt-5 text-[0.9375rem] leading-relaxed text-ink-soft">
          Or browse by kind:
          {Object.entries(GAME_CATEGORY_LABELS).map(([category, label], index) => (
            <>{index > 0 && ', '}<a class="font-semibold text-ink underline decoration-rule decoration-2 hover:decoration-ink" href={`/games/?category=${category}`}>{label}</a></>
          ))}.
        </p>
      </div>
      <ol class="border-t-2 border-ink lg:columns-2 lg:gap-x-10">
        {concepts.map((game) => (
          <li class="break-inside-avoid">
            <a class="group flex min-h-12 items-end gap-3 border-b border-rule py-3" href={gameHref(game)}>
              <span class="font-serif text-[1.0625rem] leading-snug group-hover:underline">{game.data.concept}</span>
              <span aria-hidden="true" class="mb-[0.4em] min-w-4 flex-1 border-b-2 border-dotted border-ink-muted"></span>
              <span class="shrink-0 text-[0.9375rem] font-bold font-stretch-semi-expanded">{game.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </Container>

  {starters.length > 0 && (
    <Container as="section" aria-labelledby="starters-heading" class="mt-20 sm:mt-28">
      <h2 id="starters-heading" class={sectionHeading}>New here? Start with these</h2>
      <p class="mt-3 max-w-[48ch] text-lg leading-snug text-ink-soft">The quickest boxes on the shelf. Each one takes a minute to learn and a few to play.</p>
      <ul class="mt-8 grid gap-x-8 gap-y-10 md:grid-cols-3">
        {starters.map((game) => (
          <li class="border-t-2 border-ink pt-4">
            <a class="group block" href={gameHref(game)}>
              <span class="block text-[1.75rem] leading-none font-black font-stretch-expanded tracking-[-0.02em] underline-offset-4 group-hover:underline">
                {game.data.title}
              </span>
              <span class="mt-2 block text-sm font-semibold text-ink-soft">
                {game.data.estimatedMinutes} min · {formatPlayerRange(game.data.minPlayers, game.data.maxPlayers)}
              </span>
              <span class="mt-3 block text-[1.0625rem] leading-snug text-ink-soft">{game.data.excerpt}</span>
              <span class="mt-4 block font-serif text-[1.0625rem] leading-snug">
                <span class="font-sans text-sm font-bold">Rule one: </span>{game.data.quickRules[0]}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  )}

  <Container as="section" aria-labelledby="close-heading" class="mt-20 sm:mt-28">
    <div class="max-w-[44rem] border-t-2 border-ink pt-6">
      <h2 id="close-heading" class="text-xl font-extrabold font-stretch-expanded">No accounts, no ads, no timers you didn't start.</h2>
      <p class="mt-3 font-serif text-lg leading-relaxed text-ink-soft">
        Arkedia remembers your wins and best scores in this browser and nowhere else.
        <a class="text-ink underline decoration-2 underline-offset-4" href="/about/">How Arkedia works</a>, and how to
        <a class="text-ink underline decoration-2 underline-offset-4" href="/about/#progress">clear your record</a>.
      </p>
    </div>
  </Container>

  <script type="application/json" id="game-index" set:html={JSON.stringify(gameIndex)} />
</MainLayout>

<script>
  import { onProgressChange, readAllProgress } from '../lib/progress';
  import { formatLastPlayed, recordSummary } from '../lib/record-format';

  interface IndexedGame {
    slug: string;
    title: string;
    href: string;
  }

  const section = document.getElementById('continue');
  const list = section?.querySelector('[data-continue-list]');
  const games: IndexedGame[] = JSON.parse(document.getElementById('game-index')?.textContent ?? '[]');

  function paintContinue() {
    if (!section || !list) return;
    const records = readAllProgress();
    const recent = games
      .map((game) => ({ game, record: records[game.slug] }))
      .filter((item) => item.record && item.record.plays > 0)
      .sort((left, right) => (right.record.lastPlayedAt ?? '').localeCompare(left.record.lastPlayedAt ?? ''))
      .slice(0, 4);

    section.hidden = recent.length === 0;
    list.replaceChildren(
      ...recent.map(({ game, record }) => {
        const item = document.createElement('li');
        item.className = 'border-t-2 border-ink py-4';
        const link = document.createElement('a');
        link.href = game.href;
        link.className = 'text-xl font-black font-stretch-expanded tracking-[-0.015em] underline-offset-4 hover:underline';
        link.textContent = game.title;
        const summary = document.createElement('p');
        summary.className = 'mt-2 text-[0.9375rem] font-semibold tabular-nums';
        summary.textContent = recordSummary(record);
        item.append(link, summary);
        const last = formatLastPlayed(record.lastPlayedAt);
        if (last) {
          const when = document.createElement('p');
          when.className = 'text-sm text-ink-soft';
          when.textContent = `Last played ${last}`;
          item.append(when);
        }
        return item;
      }),
    );
  }

  paintContinue();
  onProgressChange(paintContinue);
  window.addEventListener('pageshow', paintContinue);
</script>
