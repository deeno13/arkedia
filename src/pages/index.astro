---
import Callout from '../components/ui/Callout.astro';
import GameCard from '../components/ui/GameCard.astro';
import LinkButton from '../components/ui/LinkButton.astro';
import MetadataPills from '../components/ui/MetadataPills.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import { editorialPrinciples, roadmapGames } from '../data/site';
import { getPlayableGameCount, getPublishedGames } from '../lib/games';
import MainLayout from '../layouts/MainLayout.astro';

const games = await getPublishedGames();
const featuredGames = games.slice(0, 3);
const playableGameCount = getPlayableGameCount(games);
---

<MainLayout
  title="Content-first educational games"
  description="Arkedia is a static-first educational games site built with Astro, pairing readable long-form guides with optional playable widgets only where they improve learning."
>
  <PageHero
    eyebrow="Content-first educational games"
    title="Learn how games work before the interface gets in the way."
    description="Arkedia treats each game as an educational topic first. Rules, strategies, and examples live in typed MDX content, while interactive widgets appear only on pages where practice adds real value."
  >
    <MetadataPills
      slot="meta"
      label="Arkedia homepage summary"
      items={[`${games.length} published guides`, `${playableGameCount} playable widgets`, 'Static-first by default']}
    />
    <Fragment slot="actions">
      <LinkButton href="/games/">Browse games</LinkButton>
      <LinkButton href="/about/" variant="secondary">Read about Arkedia</LinkButton>
    </Fragment>
    <div slot="media" class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/70">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-sky-700">Roadmap</p>
      <ul class="mt-5 space-y-4">
        {roadmapGames.map((game, index) => (
          <li class="flex items-center justify-between gap-4 rounded-2xl bg-slate-50 px-4 py-3">
            <span class="text-sm font-medium text-slate-800">{game}</span>
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">0{index + 1}</span>
          </li>
        ))}
      </ul>
    </div>
  </PageHero>

  <Section
    eyebrow="Editorial model"
    title="A shell that stays fast while content grows richer"
    description="The site shell is built from Astro components and server-rendered HTML. That keeps the baseline experience quick, readable, and easy to evolve as the content collection expands."
  >
    <div class="grid gap-4 lg:grid-cols-3">
      {editorialPrinciples.map((principle) => (
        <Callout title="Guiding principle">
          <p>{principle}</p>
        </Callout>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="Featured pages"
    title="Initial game guides"
    description="The current collection already demonstrates the intended content flow: typed frontmatter, MDX explanations, and a clean path for optional widget attachment."
  >
    <div class="grid gap-6 md:grid-cols-2">
      {featuredGames.map((game) => <GameCard entry={game} />)}
    </div>
  </Section>

  <Section
    eyebrow="v1 foundation"
    title="Ready for more content without changing the architecture"
    description="The current release already has typed game metadata, optimized local cover images, related guides, and optional interactive islands. Adding new entries mostly means adding new content."
  >
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)]">
      <Callout title="What plugs in next">
        <ul class="space-y-3">
          <li>More MDX game guides with the same typed schema and editorial structure.</li>
          <li>Richer examples, diagrams, and callouts inside long-form content.</li>
          <li>Playable widgets attached only to games that benefit from practice.</li>
          <li>Progressive browse enhancements layered onto existing metadata.</li>
        </ul>
      </Callout>

      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-sky-700">Current collection</p>
        <p class="mt-3 text-4xl font-semibold tracking-tight text-slate-950">{games.length}</p>
        <p class="mt-2 text-sm leading-7 text-slate-600">
          Game page{games.length === 1 ? '' : 's'} already available for the content-driven routing layer.
        </p>
      </div>
    </div>
  </Section>
</MainLayout>
