---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import GameFacts from '../../components/content/GameFacts.astro';
import InteractiveWidget from '../../components/content/InteractiveWidget.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Callout from '../../components/ui/Callout.astro';
import GameCard from '../../components/ui/GameCard.astro';
import MetadataPills from '../../components/ui/MetadataPills.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Prose from '../../components/ui/Prose.astro';
import Section from '../../components/ui/Section.astro';
import {
  getPublishedGames,
  resolveRelatedGames,
  formatGamePageMetadata,
} from '../../lib/games';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const games = await getPublishedGames();

  return games.map((game) => ({
    params: { slug: game.data.slug },
    props: { game },
  }));
}

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { Content } = await render(game);
const allGames = await getPublishedGames();
const relatedGames = resolveRelatedGames(game, allGames).slice(0, 3);
const metadata = formatGamePageMetadata(game);
---

<MainLayout
  title={game.data.seoTitle}
  description={game.data.seoDescription}
  image={game.data.coverImage?.src}
  type="article"
>
  <PageHero eyebrow="Game guide" title={game.data.title} description={game.data.description}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Home', href: '/' },
        { label: 'Games', href: '/games/' },
        { label: game.data.title },
      ]}
    />
    <MetadataPills slot="meta" items={metadata} label={`${game.data.title} metadata`} />

    {game.data.coverImage && (
      <div slot="media" class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-lg shadow-slate-200/70">
        <Image
          src={game.data.coverImage}
          alt={game.data.coverImageAlt ?? ''}
          class="h-full w-full object-cover"
          widths={[640, 960]}
          sizes="(min-width: 1024px) 32rem, 100vw"
        />
      </div>
    )}
  </PageHero>

  <Section size="narrow" class="pt-10">
    <article class="space-y-10">
      <GameFacts entry={game} />

      <Callout title="Educational topics" tone="neutral">
        <div class="flex flex-wrap gap-2">
          {game.data.educationalTopics.map((topic) => (
            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700">
              {topic}
            </span>
          ))}
        </div>
      </Callout>

      <Callout title="Page model" tone="neutral">
        <p>
          This guide is rendered through Astro’s content layer and MDX pipeline. Interactive behavior remains
          optional and page-scoped instead of becoming a site-wide dependency.
        </p>
      </Callout>

      <InteractiveWidget
        isPlayable={game.data.isPlayable}
        widget={game.data.playableWidget}
        hydration={game.data.widgetHydration}
      />

      <Prose>
        <Content />
      </Prose>
    </article>
  </Section>

  {relatedGames.length > 0 && (
    <Section
      eyebrow="Related guides"
      title="Continue with related games"
      description="Related entries are resolved through each game’s `relatedGameSlugs` metadata, so authors control the editorial connections directly from content."
    >
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {relatedGames.map((entry) => <GameCard entry={entry} />)}
      </div>
    </Section>
  )}
</MainLayout>
