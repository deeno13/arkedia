---
import { render } from 'astro:content';
import InteractiveWidget from '../../components/content/InteractiveWidget.astro';
import Container from '../../components/layout/Container.astro';
import BoxLid from '../../components/ui/BoxLid.astro';
import RecordPanel from '../../components/ui/RecordPanel.astro';
import ShelfTile from '../../components/ui/ShelfTile.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import {
  GAME_CATEGORY_LABELS,
  GAME_DIFFICULTY_LABELS,
  formatPlayerRange,
  getPublishedGames,
  resolveRelatedGames,
  type GameEntry,
} from '../../lib/games';
import { inkStyle } from '../../lib/inks';

export async function getStaticPaths() {
  const games = await getPublishedGames();
  return games.map((game) => ({ params: { slug: game.data.slug }, props: { game } }));
}

interface Props {
  game: GameEntry;
}

const { game } = Astro.props;
const games = await getPublishedGames();
const { data } = game;
const { Content, headings } = await render(game);
const sections = headings.filter((heading) => heading.depth === 2);
const ideaHeading = sections.find((heading) => /idea underneath/i.test(heading.text));
const related = resolveRelatedGames(game, games).slice(0, 3);
const categoryLabel = GAME_CATEGORY_LABELS[data.category];

const facts = [
  { label: 'Players', value: formatPlayerRange(data.minPlayers, data.maxPlayers) },
  { label: 'Time', value: `About ${data.estimatedMinutes} min` },
  { label: 'Difficulty', value: GAME_DIFFICULTY_LABELS[data.difficulty] },
  { label: 'Concept', value: data.concept, href: ideaHeading && `#${ideaHeading.slug}` },
];

/* "Arrow keys: move" → a bold lead-in before the first colon, when there is one. */
const controls = data.controls.map((line) => {
  const split = line.indexOf(': ');
  return split > 0 && split < 40 ? { lead: line.slice(0, split), text: line.slice(split + 2) } : { text: line };
});

const sheetHeading = 'text-base font-extrabold font-stretch-expanded leading-tight';
---

<MainLayout
  title={data.seoTitle}
  description={data.seoDescription}
  type="article"
  image={data.coverImage}
  imageAlt={data.coverImageAlt}
  publishedTime={data.publishedAt}
  modifiedTime={data.updatedAt}
>
  <div style={inkStyle(data.ink)}>
    <Container class="pt-4 sm:pt-6">
      <header class="ink-field grid gap-x-10 gap-y-4 rounded-die bg-game px-5 py-5 text-on-game sm:px-7 lg:py-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:items-end">
        <div class="min-w-0">
          <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-x-2 text-sm font-semibold font-stretch-semi-expanded">
              <li><a class="rounded-[3px] underline decoration-2 underline-offset-4 hover:decoration-4" href="/games/">Games</a></li>
              <li aria-hidden="true">/</li>
              <li>
                <a class="rounded-[3px] underline decoration-2 underline-offset-4 hover:decoration-4" href={`/games/?category=${data.category}`}>
                  {categoryLabel}
                </a>
              </li>
            </ol>
          </nav>
          <h1 class="mt-1.5 text-[clamp(2.25rem,4.6vw,3.25rem)] leading-[0.95] font-black font-stretch-expanded tracking-[-0.02em] text-balance">
            {data.title}
          </h1>
          <p class="mt-2.5 max-w-[60ch] text-base leading-snug">{data.description}</p>
        </div>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-3 border-t-2 border-current pt-4 sm:grid-cols-4 lg:grid-cols-2 lg:border-t-0 lg:border-l-2 lg:pt-0 lg:pl-6">
          {facts.map((fact) => (
            <div class="min-w-0">
              <dt class="text-xs font-bold font-stretch-semi-expanded tracking-[0.04em] uppercase">{fact.label}</dt>
              <dd class="mt-0.5 text-[0.9375rem] leading-snug font-semibold">
                {fact.href ? (
                  <a class="rounded-[3px] underline decoration-2 underline-offset-4 hover:decoration-4" href={fact.href}>{fact.value}</a>
                ) : (
                  fact.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </header>

      <div class="mt-5 grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-8 xl:grid-cols-[minmax(0,1fr)_22rem]">
        <div id="board" class="min-w-0 scroll-mt-4">
          <InteractiveWidget widget={data.widget} slug={data.slug} title={data.title}>
            <div slot="fallback" class="rounded-die border-2 border-ink bg-card" role="status">
              <div class="h-14 border-b-2 border-ink"></div>
              <div class="grid h-[min(92vw,30rem)] place-items-center px-4">
                <p class="text-sm font-semibold text-ink-muted">Setting up the {data.title} board…</p>
              </div>
              <div class="h-14 border-t-2 border-ink"></div>
            </div>
          </InteractiveWidget>
        </div>

        <aside aria-label={`${data.title} rule sheet`} class="rounded-die border-2 border-ink bg-card">
          <section aria-labelledby="quick-rules" class="px-5 pt-5 pb-5">
            <h2 id="quick-rules" class={sheetHeading}>Learn it in a minute</h2>
            <ol class="mt-3.5 space-y-3">
              {data.quickRules.map((rule, index) => (
                <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-3 text-[0.9375rem] leading-snug">
                  <span
                    aria-hidden="true"
                    class="grid h-7 w-7 place-items-center rounded-[4px] border-2 border-ink text-sm leading-none font-black font-stretch-expanded tabular-nums"
                  >
                    {index + 1}
                  </span>
                  <span class="pt-0.5"><span class="sr-only">Rule {index + 1}: </span>{rule}</span>
                </li>
              ))}
            </ol>
          </section>

          <section aria-labelledby="controls" class="border-t border-rule px-5 py-5">
            <h2 id="controls" class={sheetHeading}>Controls</h2>
            <ul class="mt-3 space-y-2 text-[0.9375rem] leading-snug">
              {controls.map((control) => (
                <li>
                  {control.lead && <strong class="font-bold">{control.lead}: </strong>}
                  {control.text}
                </li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="skills" class="border-t border-rule px-5 py-5">
            <h2 id="skills" class={sheetHeading}>Skills it trains</h2>
            <ul class="mt-3 flex flex-wrap gap-1.5 text-sm">
              {data.skills.map((skill) => (
                <li class="rounded-[4px] bg-paper-deep px-2 py-1 font-semibold first-letter:uppercase">{skill}</li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="your-record" class="border-t border-rule px-5 py-5">
            <h2 id="your-record" class={sheetHeading}>Your record</h2>
            <div class="mt-3">
              <RecordPanel slug={data.slug} title={data.title} />
            </div>
          </section>
        </aside>
      </div>

      <div class="mt-16 grid gap-8 border-t-2 border-ink pt-8 sm:mt-20 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-12 lg:pt-10">
        {sections.length > 0 && (
          <nav aria-labelledby="on-this-page" class="lg:sticky lg:top-6 lg:self-start">
            <h2 id="on-this-page" class="text-sm font-extrabold font-stretch-semi-expanded">On this page</h2>
            <ol class="mt-3 space-y-1 border-l border-rule text-[0.9375rem]">
              {sections.map((heading) => (
                <li>
                  <a
                    class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-ink-soft hover:border-ink hover:text-ink"
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
              <li>
                <a class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-ink-soft hover:border-ink hover:text-ink" href="#board">
                  Back to the board
                </a>
              </li>
            </ol>
          </nav>
        )}
        <article class="content-prose min-w-0">
          <Content />
        </article>
      </div>

      {related.length > 0 && (
        <section aria-labelledby="play-next" class="mt-20">
          <h2 id="play-next" class="text-2xl leading-tight font-black font-stretch-expanded tracking-[-0.015em] sm:text-3xl">Play next</h2>
          <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
            {related.map((entry) => (
              <li><BoxLid entry={entry} /></li>
            ))}
            <li class:list={[related.length === 3 && 'sm:hidden lg:block']}>
              <ShelfTile href="/games/" title="The whole shelf" text={`All ${games.length} games`} />
            </li>
          </ul>
        </section>
      )}
    </Container>
  </div>
</MainLayout>
