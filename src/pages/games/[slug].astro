---
import { render, type CollectionEntry } from 'astro:content';
import GameFacts from '../../components/content/GameFacts.astro';
import InteractiveWidget from '../../components/content/InteractiveWidget.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Callout from '../../components/ui/Callout.astro';
import GameCard from '../../components/ui/GameCard.astro';
import GameCoverImage from '../../components/ui/GameCoverImage.astro';
import MetadataPills from '../../components/ui/MetadataPills.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Prose from '../../components/ui/Prose.astro';
import Section from '../../components/ui/Section.astro';
import {
  getPublishedGames,
  resolveRelatedGames,
  formatGamePageMetadata,
} from '../../lib/games';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const games = await getPublishedGames();

  return games.map((game) => ({
    params: { slug: game.data.slug },
    props: { game },
  }));
}

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { Content } = await render(game);
const allGames = await getPublishedGames();
const relatedGames = resolveRelatedGames(game, allGames).slice(0, 3);
const metadata = formatGamePageMetadata(game);
---

<MainLayout
  title={game.data.seoTitle}
  description={game.data.seoDescription}
  image={game.data.coverImage}
  imageAlt={game.data.coverImageAlt}
  type="article"
  publishedTime={game.data.publishedAt}
  modifiedTime={game.data.updatedAt ?? game.data.publishedAt}
>
  <PageHero eyebrow="Game guide" title={game.data.title} description={game.data.description}>
    <Breadcrumbs
      slot="breadcrumbs"
      items={[
        { label: 'Home', href: '/' },
        { label: 'Games', href: '/games/' },
        { label: game.data.title },
      ]}
    />
    <MetadataPills slot="meta" items={metadata} label={`${game.data.title} metadata`} />

    {game.data.coverImage && (
      <div slot="media" class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-lg shadow-slate-200/70">
        <GameCoverImage
          image={game.data.coverImage}
          alt={game.data.coverImageAlt ?? game.data.title}
          variant="hero"
        />
      </div>
    )}
  </PageHero>

  <Section size="narrow" class="pt-10">
    <article class="space-y-10">
      <GameFacts entry={game} />

      <div class="grid gap-4 lg:grid-cols-2">
        <Callout title="Educational topics" tone="neutral">
          <div class="flex flex-wrap gap-2">
            {game.data.educationalTopics.map((topic) => (
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700">
                {topic}
              </span>
            ))}
          </div>
        </Callout>

        <Callout title="Tags and format" tone="neutral">
          <div class="space-y-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Tags</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {game.data.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <p>
              {game.data.isPlayable
                ? 'This page includes a playable island, but the surrounding layout and content stay static-first.'
                : 'This page is content-first today and ready for a focused playable extension later if the game benefits from one.'}
            </p>
          </div>
        </Callout>
      </div>

      <InteractiveWidget
        isPlayable={game.data.isPlayable}
        widget={game.data.playableWidget}
        hydration={game.data.widgetHydration}
      />

      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm shadow-slate-200/60 sm:p-8">
        <Prose>
          <Content />
        </Prose>
      </div>
    </article>
  </Section>

  {relatedGames.length > 0 && (
    <Section
      eyebrow="Related guides"
      title="Continue with related games"
      description="Related entries are resolved through each game’s `relatedGameSlugs` metadata, so authors control the editorial connections directly from content."
    >
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {relatedGames.map((entry) => <GameCard entry={entry} />)}
      </div>
    </Section>
  )}
</MainLayout>
