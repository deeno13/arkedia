---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import InteractiveWidget from '../../components/content/InteractiveWidget.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => !data.draft);

  return games.map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { Content } = await render(game);
---

<BaseLayout title={`${game.data.title} | Arkedia`} description={game.data.description}>
  <article class="mx-auto max-w-3xl">
    <header class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm shadow-slate-200/60">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-sky-700">{game.data.difficulty}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950">{game.data.title}</h1>
      <p class="mt-4 text-lg leading-8 text-slate-700">{game.data.description}</p>

      {game.data.tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2 text-sm text-slate-600">
          {game.data.tags.map((tag) => (
            <li class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">{tag}</li>
          ))}
        </ul>
      )}
    </header>

    <InteractiveWidget widget={game.data.widget} hydration={game.data.widgetHydration} />

    <div class="content-prose mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
