---
import { getCollection } from 'astro:content';
import GameCard from '../../components/ui/GameCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const games = (await getCollection('games', ({ data }) => !data.draft)).sort(
  (left, right) => left.data.title.localeCompare(right.data.title),
);
---

<BaseLayout
  title="Games | Arkedia"
  description="Explore educational game pages authored through Astro content collections and enhanced with optional interactive islands."
>
  <section class="space-y-4">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-700">Games collection</p>
    <h1 class="text-4xl font-semibold tracking-tight text-slate-950">Content-driven game pages</h1>
    <p class="max-w-3xl text-lg leading-8 text-slate-700">
      Each entry in the games collection owns its metadata, educational copy, and optional widget attachment.
      That keeps routing and page generation simple while preserving a static-first site.
    </p>
  </section>

  <section class="mt-10 grid gap-4 md:grid-cols-2">
    {games.map((game) => <GameCard entry={game} />)}
  </section>
</BaseLayout>
