---
import Container from '../../components/layout/Container.astro';
import BoxLid from '../../components/ui/BoxLid.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { GAME_CATEGORY_LABELS, GAME_DIFFICULTY_LABELS, getPublishedGames } from '../../lib/games';

const games = await getPublishedGames();

const filterGroups = [
  { name: 'category', legend: 'Kind', options: [['', 'All'], ...Object.entries(GAME_CATEGORY_LABELS)] },
  { name: 'difficulty', legend: 'Difficulty', options: [['', 'Any'], ...Object.entries(GAME_DIFFICULTY_LABELS)] },
  { name: 'players', legend: 'Players', options: [['', 'Any'], ['solo', 'Solo'], ['two', 'Two players']] },
  { name: 'yours', legend: 'Yours', options: [['', 'All'], ['new', 'New to you'], ['played', 'Played'], ['won', 'Won']] },
];
---

<MainLayout
  title="All games"
  description={`Browse all ${games.length} Arkedia games by kind, difficulty and players. Each one opens to its rules, a board to play on and a guide to playing it well.`}
>
  <Container class="pt-8 sm:pt-12">
    <h1 class="text-[clamp(2.25rem,5vw,3.75rem)] leading-[0.95] font-black font-stretch-expanded tracking-[-0.03em] text-balance">
      Every game on the shelf
    </h1>
    <p class="mt-4 max-w-[52ch] text-lg leading-snug text-ink-soft">
      Each box opens to the rules in a minute, a board to play on and a guide to playing it well.
    </p>

    <form data-filters hidden aria-label="Filter games" class="mt-8 flex flex-wrap gap-x-8 gap-y-4 border-y-2 border-ink py-4">
      {filterGroups.map((group) => (
        <fieldset class="min-w-0">
          <legend class="float-left mr-3 flex min-h-10 items-center text-sm font-bold font-stretch-semi-expanded">{group.legend}</legend>
          <div class="flex flex-wrap gap-1.5">
            {group.options.map(([value, label]) => (
              <label class="relative">
                <input class="peer sr-only" type="radio" name={group.name} value={value} checked={value === ''} />
                <span class="inline-flex min-h-10 cursor-pointer items-center rounded-die border-2 border-ink px-3 text-sm font-semibold font-stretch-semi-expanded transition-colors duration-150 select-none peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink hover:bg-paper-deep peer-checked:hover:bg-ink">
                  {label}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
    </form>

    <p data-count aria-live="polite" class="mt-5 min-h-6 text-[0.9375rem] font-semibold tabular-nums text-ink-soft">
      {games.length} games
    </p>

    <ul data-shelf class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 lg:gap-5">
      {games.map((game) => (
        <li><BoxLid entry={game} headingLevel="h2" /></li>
      ))}
    </ul>

    <div data-empty hidden class="mt-3 flex flex-col items-start gap-4 rounded-die border-2 border-dashed border-ink px-6 py-10 sm:px-10">
      <p class="text-2xl leading-tight font-black font-stretch-expanded">No box matches all of that.</p>
      <p class="max-w-[48ch] text-ink-soft">Loosen one of the filters above, or clear them all and start from the full shelf.</p>
      <button
        type="button"
        data-reset
        class="inline-flex min-h-11 items-center rounded-die border-2 border-ink bg-ink px-4 font-semibold font-stretch-semi-expanded text-paper transition-colors duration-150 hover:bg-ink-soft"
      >
        Clear filters
      </button>
    </div>
  </Container>
</MainLayout>

<script>
  import { onProgressChange, readAllProgress } from '../../lib/progress';

  const KEYS = ['category', 'difficulty', 'players', 'yours'] as const;
  type Key = (typeof KEYS)[number];

  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const shelf = document.querySelector<HTMLElement>('[data-shelf]')!;
  const lids = [...shelf.querySelectorAll<HTMLElement>('[data-lid]')];

  const allowed = (key: Key) => [...form.querySelectorAll<HTMLInputElement>(`input[name="${key}"]`)].map((input) => input.value);

  function readForm() {
    const data = new FormData(form);
    return Object.fromEntries(KEYS.map((key) => [key, String(data.get(key) ?? '')])) as Record<Key, string>;
  }

  function writeForm(state: Record<Key, string>) {
    for (const key of KEYS) {
      const input = form.querySelector<HTMLInputElement>(`input[name="${key}"][value="${CSS.escape(state[key])}"]`);
      if (input) input.checked = true;
    }
  }

  function stateFromUrl() {
    const params = new URLSearchParams(location.search);
    return Object.fromEntries(
      KEYS.map((key) => {
        const value = params.get(key) ?? '';
        return [key, allowed(key).includes(value) ? value : ''];
      }),
    ) as Record<Key, string>;
  }

  function apply(state: Record<Key, string>) {
    const records = readAllProgress();
    let shown = 0;
    for (const lid of lids) {
      const record = records[lid.dataset.slug ?? ''];
      const played = Boolean(record && record.plays > 0);
      const yours =
        state.yours === '' ||
        (state.yours === 'new' && !played) ||
        (state.yours === 'played' && played) ||
        (state.yours === 'won' && Boolean(record && record.wins > 0));
      const match =
        yours &&
        (state.category === '' || lid.dataset.category === state.category) &&
        (state.difficulty === '' || lid.dataset.difficulty === state.difficulty) &&
        (state.players === '' || lid.dataset.players === state.players);
      lid.closest('li')!.hidden = !match;
      if (match) shown += 1;
    }
    const filtered = KEYS.some((key) => state[key] !== '');
    count.textContent = filtered ? `${shown} of ${lids.length} games` : `All ${lids.length} games`;
    empty.hidden = shown > 0;
    shelf.hidden = shown === 0;
  }

  function syncUrl(state: Record<Key, string>) {
    const params = new URLSearchParams();
    for (const key of KEYS) if (state[key]) params.set(key, state[key]);
    const query = params.toString();
    const next = `${location.pathname}${query ? `?${query}` : ''}${location.hash}`;
    if (next !== `${location.pathname}${location.search}${location.hash}`) history.replaceState(history.state, '', next);
  }

  function restore() {
    const state = stateFromUrl();
    writeForm(state);
    apply(state);
  }

  form.hidden = false;
  restore();

  form.addEventListener('change', () => {
    const state = readForm();
    apply(state);
    syncUrl(state);
  });
  form.addEventListener('submit', (event) => event.preventDefault());

  document.querySelector('[data-reset]')!.addEventListener('click', () => {
    const cleared = Object.fromEntries(KEYS.map((key) => [key, ''])) as Record<Key, string>;
    writeForm(cleared);
    apply(cleared);
    syncUrl(cleared);
    form.querySelector<HTMLInputElement>('input:checked')?.focus();
  });

  window.addEventListener('popstate', restore);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) restore();
  });
  onProgressChange(() => apply(readForm()));
</script>
